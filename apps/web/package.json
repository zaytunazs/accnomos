{
    "name": "web",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "test:unit": "node --test tests/unit/*.test.ts",
        "e2e": "pnpm run e2e:build && pnpm run e2e:test",
        "e2e:build": "node e2e/build.mjs",
        "e2e:test": "playwright test",
        "e2e:demo": "pnpm run e2e:build && E2E_DEMO_SHOTS=1 playwright test --project=demo",
        "size": "node scripts/route-sizes.mjs out",
        "bridge": "esbuild node_modules/@azure/msal-browser/dist/redirect_bridge/index.mjs --bundle --format=esm --minify --outfile=public/auth/msal-redirect-bridge.js"
    },
    "dependencies": {
        "@azure/msal-browser": "^5.29.0",
        "@azure/msal-react": "^5.8.1",
        "@sentry/browser": "^11.11.0",
        "ag-grid-community": "36.3.0",
        "ag-grid-react": "36.3.0",
        "fflate": "^0.8.3",
        "next": "16.4.5",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/turbopack": "^4",
        "@types/node": "^26",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "esbuild": "^0.28.2",
        "eslint": "^10",
        "eslint-config-next": "16.4.5",
        "tailwindcss": "^4",
        "typescript": "^7"
    },
    "packageManager": "pnpm@11.9.0"
}
