<?xml version="1.0" encoding="utf-8"?>
<!-- Release and profile builds (SEC-05): HTTPS everywhere, except plain HTTP to the owner's own machines on a LAN or
     this device, where a local reader (Ollama on the DGX Spark) or a development runtime has no certificate.
     Android cannot list an IP range here, so the known hosts are named; any other http:// address is refused, so a
     Graph token or Meta key is never sent unencrypted across the internet. Debug builds allow any host
     (src/debug/res/xml/network_security_config.xml). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.176</domain>
        <domain includeSubdomains="false">192.168.1.78</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
