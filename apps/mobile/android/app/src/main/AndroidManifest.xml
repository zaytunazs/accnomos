<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed by image_picker to take photos. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Needed for hold-to-talk questions on the Ask screen. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Contacts › Import contacts › Phone: lists the phone's contacts so the user can tick which to add. Asked for
         only when that list is opened; read-only, nothing is written to the phone. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Needed by MSAL for browser-delegated Microsoft sign-in. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Plain http: only to the owner's LAN hosts in release builds, anywhere in debug builds
         (res/xml/network_security_config.xml in src/main and src/debug; SEC-05). -->
    <!-- No backups: settings hold the user's own AI API key (shared_preferences), which Auto Backup would copy to the
         cloud. Reinstalling means entering settings again. -->
    <application
        android:label="Accnomos"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- "Share to Accnomos": images and PDFs from gallery, email, files. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <!-- HMRC sign-in (VAT): accnomos.com/auth/hmrc-app.html hands HMRC's one-time PKCE code back to the app here
                 (lib/services/hmrc.dart). The code is useless without the verifier only this app holds. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.accnomos.app" android:host="hmrc" android:path="/callback" />
            </intent-filter>
        </activity>
        <!-- MSAL redirect target for Microsoft sign-in. The path is the
             base64 signature hash of the signing key, injected by Gradle
             (-PmsalSignatureHash=...; debug key by default). Unencoded here. -->
        <activity android:name="com.microsoft.identity.client.BrowserTabActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="msauth"
                    android:host="com.accnomos.app"
                    android:path="/${msalSignatureHash}" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Needed by image_picker to launch the camera (API 30+ package visibility). -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <!-- The hands-free assistant reads answers aloud with the phone's text-to-speech engine (SpeechChannel.kt). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
