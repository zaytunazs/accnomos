# Copy to .env (git-ignored). The owner fills these in by hand; nothing here is ever committed.

# --- Meta Model API (used by the runtime only when the user chooses "own key"; the demo key is the owner's) ---
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1

# --- AI provider chain (runtime; docs/PRODUCTION.md section 7) ---
# Requests with no AI choice try these in order; a provider without its settings drops out.
# Owner's decision (11 Nov 2026): our own server (spark) first, Anthropic as the backup; no documents to Meta.
AI_PROVIDERS=spark,anthropic
# Anthropic Messages API (app/ai/anthropic.py): the backup when the Spark cannot answer. No key = not in the chain.
# Not zero-data-retention by default (Anthropic deletes API data within 30 days); its Commercial Terms forbid training.
ANTHROPIC_API_KEY=
# The cheap vision model by default; ANTHROPIC_VERIFY_MODEL is the Verifier's model when it runs there (default: the same).
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_VERIFY_MODEL=
# Optional: ANTHROPIC_BASE=https://api.anthropic.com/v1, ANTHROPIC_VERSION=2026-10-21, ANTHROPIC_MAX_TOKENS=4096,
# ANTHROPIC_CONNECT_S=10, ANTHROPIC_FIRST_TOKEN_S=90, ANTHROPIC_REQUEST_S=120.
# Who reads second: chain (default: the chain's order, documents stay on our server while it is up) | anthropic
# (a different model from the Glimmer reader, but every document then goes to Anthropic) | spark.
VERIFIER_PROVIDER=chain
# Muse Glimmer 30B on a hosted GPU (supported, not deployed): the URL `modal deploy tools/modal_glimmer.py` prints,
# and (deployed with MODAL_PROXY_AUTH=1) a proxy-auth token from the GPU host's workspace settings.
MODAL_GLIMMER_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Muse Spark on the Meta Model API with the owner's key. Not in the live chain since 11 Nov 2026 (and not needed
# for voice any more); leave empty so nothing goes to Meta.
META_API_KEY=
# SAM 3.1 crop runs on Meta's Model API: keep it off (0 or empty). The code crop is used instead.
SAM_CROP=0

# --- Speech-to-text (app/ai/stt.py): our own server's speech-to-text by default; Meta only when switched on ---
# local (default): the Spark's spark-voice service, OpenAI-compatible POST {STT_BASE}/v1/audio/transcriptions.
# meta: Muse Voice Transcribe (META_API_KEY) first, our own server second (sends recordings to Meta).
STT_PROVIDER=local
# The service's base as the runtime container sees it (default below); off = no voice.
STT_BASE=http://host.docker.internal:8890
# Optional: SPARK_WHISPER_URL (a full .../v1 URL, wins over STT_BASE), SPARK_WHISPER_MODEL (default: the first id
# GET {STT_BASE}/v1/models lists), SPARK_WHISPER_KEY (a bearer token), STT_PROVIDERS=whisper,muse (explicit order).
SPARK_WHISPER_URL=
SPARK_WHISPER_MODEL=
SPARK_WHISPER_KEY=

# --- Local Meta agent (Muse Glimmer 30B on a local model server; demo = our own server) ---
OLLAMA_BASE=http://192.168.1.176:11434
OLLAMA_MODEL=muse-glimmer:30b

# --- Microsoft Entra app (public client, PKCE; no secret) ---
MS_CLIENT_ID=
MS_AUTHORITY=https://login.microsoftonline.com/common
NEXT_PUBLIC_MS_CLIENT_ID=
NEXT_PUBLIC_MS_AUTHORITY=https://login.microsoftonline.com/common

# --- HMRC (only the relay reads these) ---
# sandbox (default) or production. Production uses HMRC's live hosts and the HMRC_PROD_* credentials for VAT;
# the sandbox application below stays in use for the demo. Income Tax is sandbox only whatever this says.
HMRC_ENV=sandbox
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
HMRC_PROD_CLIENT_ID=
HMRC_PROD_CLIENT_SECRET=
HMRC_BASE=https://test-api.service.hmrc.gov.uk
HMRC_AUTH_BASE=https://test-www.tax.service.gov.uk
HMRC_REDIRECT_URI=http://localhost:8787/hmrc/callback
HMRC_VENDOR_PRODUCT_NAME=Accnomos
HMRC_VENDOR_VERSION=0.1.0

# --- Company and VAT look-ups (runtime) ---
# Companies House Public Data API key (free, from developer.company-information.service.gov.uk; HTTP Basic,
# key as username). Empty = Look up is hidden in the app. The same key works for live data: there is no CH sandbox.
COMPANIES_HOUSE_API_KEY=
# Live price search provider (docs/PRODUCTION.md). Empty or none = off. No real provider ships yet.
PRICE_SEARCH_PROVIDER=
# Where the runtime reaches the relay for "Check VAT number" (sandbox or live is the relay's HMRC_BASE).
HMRC_RELAY_URL=http://localhost:8787

# --- Online payments: payment links on invoices (runtime; app/online_payments.py) ---
# The PLATFORM's credentials only; each user links their own Stripe/PayPal account from Settings and only that
# account id is kept, in their own OneDrive. Empty = that provider is off, with a sentence saying so in the app.
# Test mode only: a live Stripe key (sk_live_) or PayPal's live API is refused unless PAYMENTS_LIVE=1.
# Stripe Connect (Dashboard > Settings > Connect > Onboarding options > OAuth): secret key, the Connect client id
# (ca_...), and this runtime's callback, registered there as a redirect URI.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_REDIRECT_URI=https://api.accnomos.com/payments/online/stripe/callback
# PayPal REST app (developer.paypal.com > Apps & Credentials, Sandbox) and the partner account it belongs to.
# Partner onboarding (partner referrals, acting for a merchant) needs PayPal to approve the platform as a partner.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
PAYPAL_RETURN_URL=https://api.accnomos.com/payments/online/paypal/callback
PAYPAL_BASE=https://api-m.sandbox.paypal.com
# Optional: a separate key for signing the connect state (default: derived from the provider's secret).
PAYMENTS_STATE_KEY=
PAYMENTS_LIVE=
# Direct mode (the sandbox demo): no Connect OAuth and no PayPal partner onboarding. Links are made on the server's
# OWN test account, which every user's books then point at, so it is refused with a live key or PayPal's live API.
# PayPal needs only PAYPAL_CLIENT_ID + PAYPAL_CLIENT_SECRET (a Sandbox REST app); Stripe only an sk_test_ key.
# The callbacks default to RUNTIME_PUBLIC_URL + /payments/online/{paypal|stripe}/callback.
# Smoke test against the real sandbox: tools/payments_sandbox_smoke.py
PAYPAL_DIRECT=
STRIPE_DIRECT=
# PayPal is the default for invoice links; Stripe links are hidden (on hold) unless this is 1. Match it in the web
# build (NEXT_PUBLIC_STRIPE_VISIBLE below), which only decides whether static wording names Stripe.
STRIPE_VISIBLE=

# --- Plans, billing, admin, analytics (runtime; app/billing, docs/billing/PLANS_AND_CONTRACT.md) ---
# Account registry: Supabase (UK/EU region), schema accnomos (supabase/README.md). Both empty = billing off: every
# feature without limits, GET /account says "not configured". The service-role key never leaves the runtime host.
# SUPABASE_SERVICE_ROLE_KEY takes either kind of server key: a new secret key (sb_secret_...) or a legacy
# service_role JWT. Supabase retires the legacy JWT keys in early 2027: prefer a secret key. (Not the publishable
# key: it cannot read the accnomos schema.)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Who takes payment for Accnomos plans (app/billing/payments.py): none (the default), paypal (the owner's choice:
# PayPal Subscriptions, sandbox first) or stripe (kept in code, on hold). With none the plans, the 90-day trial and
# promo codes work and nothing can be bought (checkout, portal and top-up answer 503; the apps show no buy buttons and
# name no provider). The PayPal settings below are used only with paypal, the Stripe ones only with stripe.
# Not the invoice payment links above (the user's own Stripe or PayPal). The web build's NEXT_PUBLIC_PAYMENTS_PROVIDER
# should match (it decides only whether the pricing and privacy pages name the provider).
PAYMENTS_PROVIDER=none
# PayPal Subscriptions (app/billing/paypal_api.py) use PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET / PAYPAL_BASE above
# (the same sandbox REST app as the invoice links; PayPal's live API is refused unless PAYMENTS_LIVE=1), plus:
# the webhook id from the developer dashboard (webhook URL https://api.accnomos.com/billing/paypal/webhook; events
# BILLING.SUBSCRIPTION.ACTIVATED, UPDATED, CANCELLED, EXPIRED, SUSPENDED, PAYMENT.FAILED, PAYMENT.SALE.COMPLETED,
# CHECKOUT.ORDER.APPROVED). Every webhook is checked with PayPal against this id; without it none is trusted.
PAYPAL_WEBHOOK_ID=
# The plan ids (P-...), printed by tools/paypal_billing_setup.py (creates the product and the six plans in the sandbox).
PAYPAL_PRODUCT_ID=
PAYPAL_PLAN_STARTER_MONTH=
PAYPAL_PLAN_STARTER_YEAR=
PAYPAL_PLAN_COMPREHENSIVE_MONTH=
PAYPAL_PLAN_COMPREHENSIVE_YEAR=
PAYPAL_PLAN_ULTIMATE_MONTH=
PAYPAL_PLAN_ULTIMATE_YEAR=
# UK VAT PayPal adds on top of the ex-VAT plan price (taxes.percentage on each plan) and on the top-up. Default 20.
PAYPAL_VAT_PERCENT=
# Stripe Billing uses STRIPE_SECRET_KEY above (the same platform account; a live key is needed for real
# subscriptions) plus the webhook endpoint's signing secret (Dashboard > Developers > Webhooks:
# https://api.accnomos.com/billing/stripe/webhook).
STRIPE_WEBHOOK_SECRET=
# Optional price ids (price_...) instead of the ones made by the admin's "Sync prices to Stripe":
# STRIPE_PRICE_STARTER_MONTH= STRIPE_PRICE_STARTER_YEAR= STRIPE_PRICE_COMPREHENSIVE_MONTH= ...
# STRIPE_PRICE_TOPUP=  (else the top-up is priced inline: 100 documents, £3 ex VAT)
# Where PayPal's approval (or Stripe Checkout and its portal) sends people back (default:
# $ACCNOMOS_WEB_URL/settings/billing).
BILLING_RETURN_URL=
# Admin allow-list: the verified sign-in's email, comma-separated.
ADMIN_EMAILS=
# Error reports (Sentry, EU region); empty = off. Needs sentry-sdk installed (the Docker image has it).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Per-account rate limits for POST /events and POST /bug-reports (per minute).
EVENTS_PER_MIN=60
BUG_REPORTS_PER_MIN=3

# --- Bank feeds: TrueLayer Data API (runtime; app/bank_feeds.py, docs/research/BANK_FEEDS.md) ---
# Empty = bank feeds off, with a sentence saying so on the Bank page (CSV import still works).
# TrueLayer console (sandbox app): client id and secret, and this runtime's callback registered as a redirect URI.
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
BANKFEEDS_REDIRECT_URI=https://api.accnomos.com/books/bankfeeds/callback
# 32 random bytes, base64 (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())").
# Seals each user's refresh token in their own OneDrive. Changing it makes every user connect their bank again.
BANKFEEDS_TOKEN_KEY=
# sandbox (default) or live; live is refused unless BANKFEEDS_LIVE=1 too.
TRUELAYER_ENV=sandbox
BANKFEEDS_LIVE=

# --- Optional verifier (Muse Spark Open, hosted open weights) ---
# Only the owner sets this, on the runtime server. Used only for users in key mode; local-mode
# documents are verified by Glimmer on the same machine and never sent to the host.
# Empty = key-mode users are verified by muse-spark-1.3 with their own Meta key.
BASETEN_API_KEY=
# VERIFIER_MODEL wins over BASETEN_MODEL; confirm the slug in the host's model list.
VERIFIER_MODEL=
BASETEN_MODEL=meta-models/muse-spark-open
# VERIFIER=off skips the second reading entirely.
VERIFIER=

# --- Demo sandbox for judges and visitors (runtime; services/runtime/app/demo.py, docs/PRODUCTION.md) ---
# DEMO_MODE=1 gives every visitor their own in-memory copy of the sample books, no Microsoft sign-in.
# It refuses to start without DEMO_SECRET: 32+ random characters (e.g. `openssl rand -hex 32`), used only to sign
# demo session ids. Optional limits: DEMO_MAX_SESSIONS (200), DEMO_IDLE_TTL_S (7200), DEMO_MAX_SESSION_BYTES,
# DEMO_MAX_SESSION_FILES, DEMO_MAX_FILE_BYTES, DEMO_MAX_TOTAL_BYTES, DEMO_SESSIONS_PER_IP_PER_MIN, DEMO_GRAPH_PER_MIN.
DEMO_MODE=0
DEMO_SECRET=

# --- Accountant collaboration (services/runtime/app/accountant.py) ---
# The Microsoft account of the operator's own accounting team ("Accnomos accountants"). Empty hides the opt-in.
ACCOUNTANT_TEAM_EMAIL=
# Where the web app is, for the portal link in the sharing invitation (optional; without it the email carries the
# client code only).
ACCNOMOS_WEB_URL=

# --- Website chat "Ask about Accnomos" (runtime, POST /public/chat; docs/PRODUCTION.md) ---
# Where off-topic questions are referred. Questions are answered only from services/runtime/app/public_kb.md.
PUBLIC_CONTACT_EMAIL=zohaibsharif@gmail.com
# Questions per minute per visitor address (0 = no chat-specific limit; RATE_LIMIT_PER_MIN still applies).
PUBLIC_CHAT_PER_MIN=6
# off = the route answers 503 and the website shows the contact address instead.
PUBLIC_CHAT=on
# Model for the chat: local (OLLAMA_BASE/OLLAMA_MODEL) unless set to key on purpose (then META_API_KEY is spent).
PUBLIC_CHAT_AI_MODE=local
PUBLIC_CHAT_MODEL=
# Hosts the chat may link to (comma-separated); any other link in an answer is removed.
PUBLIC_SITE_HOSTS=accnomos.com
# 1 = the judged build (no launch date or "coming soon"); 0 = pre-launch site. Match it in the web build:
PUBLIC_SUBMISSION_MODE=1
NEXT_PUBLIC_SUBMISSION_MODE=1
# Who takes payment for plans, as the runtime's PAYMENTS_PROVIDER (none | paypal | stripe): only names the provider on
# /pricing and /privacy (paypal: PayPal is named as the payment processor). Buy buttons follow GET /account.
NEXT_PUBLIC_PAYMENTS_PROVIDER=none
# 1 = static wording about invoice payment links names Stripe too (match the runtime's STRIPE_VISIBLE).
NEXT_PUBLIC_STRIPE_VISIBLE=
NEXT_PUBLIC_CONTACT_EMAIL=zohaibsharif@gmail.com
