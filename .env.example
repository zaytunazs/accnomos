# Copy to .env (git-ignored). The owner fills these in by hand; nothing here is ever committed.

# --- Meta Model API (used by the runtime only when the user chooses "own key"; the demo key is the owner's) ---
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1

# --- Local Meta agent (Muse Glimmer 30B via Ollama; demo = DGX Spark) ---
OLLAMA_BASE=http://192.168.1.176:11434
OLLAMA_MODEL=muse-glimmer:30b

# --- Microsoft Entra app (public client, PKCE; no secret) ---
MS_CLIENT_ID=
MS_AUTHORITY=https://login.microsoftonline.com/common
NEXT_PUBLIC_MS_CLIENT_ID=
NEXT_PUBLIC_MS_AUTHORITY=https://login.microsoftonline.com/common

# --- HMRC sandbox (only the relay reads these) ---
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
HMRC_BASE=https://test-api.service.hmrc.gov.uk
HMRC_AUTH_BASE=https://test-www.tax.service.gov.uk
HMRC_REDIRECT_URI=http://localhost:8787/hmrc/callback
HMRC_VENDOR_PRODUCT_NAME=Accnomos
HMRC_VENDOR_VERSION=0.1.0

# --- Company and VAT look-ups (runtime) ---
# Companies House Public Data API key (free, from developer.company-information.service.gov.uk; HTTP Basic,
# key as username). Empty = Look up is hidden in the app. The same key works for live data: there is no CH sandbox.
COMPANIES_HOUSE_API_KEY=
# Where the runtime reaches the relay for "Check VAT number" (sandbox or live is the relay's HMRC_BASE).
HMRC_RELAY_URL=http://localhost:8787

# --- Optional verifier (Muse Spark Open on Baseten) ---
# Only the owner sets this, on the runtime server. Used only for users in key mode; local-mode
# documents are verified by Glimmer on the same machine and never sent to Baseten.
# Empty = key-mode users are verified by muse-spark-1.3 with their own Meta key.
BASETEN_API_KEY=
# VERIFIER_MODEL wins over BASETEN_MODEL; confirm the slug in Baseten's Model APIs list.
VERIFIER_MODEL=
BASETEN_MODEL=meta-models/muse-spark-open
# VERIFIER=off skips the second reading entirely.
VERIFIER=

# --- Demo sandbox for judges and visitors (runtime; services/runtime/app/demo.py, docs/PRODUCTION.md) ---
# DEMO_MODE=1 gives every visitor their own in-memory copy of the sample books, no Microsoft sign-in.
# It refuses to start without DEMO_SECRET: 32+ random characters (e.g. `openssl rand -hex 32`), used only to sign
# demo session ids. Optional limits: DEMO_MAX_SESSIONS (200), DEMO_IDLE_TTL_S (7200), DEMO_MAX_SESSION_BYTES,
# DEMO_MAX_SESSION_FILES, DEMO_MAX_FILE_BYTES, DEMO_MAX_TOTAL_BYTES, DEMO_SESSIONS_PER_IP_PER_MIN, DEMO_GRAPH_PER_MIN.
DEMO_MODE=0
DEMO_SECRET=
