# Accnomos HMRC relay — the one component that holds a secret (HMRC client secret, via env). Built from the repo root.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /srv
COPY services/hmrc-relay /srv/services/hmrc-relay
RUN pip install /srv/services/hmrc-relay
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8787/health')"
CMD ["uvicorn", "relay.main:app", "--host", "0.0.0.0", "--port", "8787", "--proxy-headers", "--forwarded-allow-ips", "*"]
